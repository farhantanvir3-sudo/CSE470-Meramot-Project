APP_NAME=Meramot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 Database Configuration (Local & Production Standard)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=meramot
DB_USERNAME=postgres
DB_PASSWORD=

# Optional: Single PostgreSQL Connection URL (uncomment to override the above on Render/Supabase/Neon)
# DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/meramot

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Pusher Channels Configuration
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap2

# SSLCommerz Payment Gateway (Sandbox)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=testbox_live
SSLCOMMERZ_IS_SANDBOX=true

# BulkSMS BD Configuration (Feature R14)
BULKSMS_API_KEY=your_bulksms_api_key
BULKSMS_SENDER_ID=MERAMOT_ALERT

# Official Meramot Gmail REST API & Google OAuth 2.0 (HTTPS Port 443)
ENABLE_EMAIL_NOTIFICATIONS=true
GMAIL_USER=meramotbd.official@gmail.com
GMAIL_FROM="Meramot Official <meramotbd.official@gmail.com>"
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# FastAPI Python AI Microservice Integration (Features R10, R13)
AI_MICROSERVICE_URL=http://127.0.0.1:5000
