#!/usr/bin/env sh
# ============================================================================
# MERAMOT GIT HOOK: Protect 'main' against direct non-admin commits
# ============================================================================

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$BRANCH" = "main" ]; then
    GIT_USER=$(git config user.name 2>/dev/null)
    GIT_EMAIL=$(git config user.email 2>/dev/null)

    case "$GIT_USER $GIT_EMAIL" in
        *farhantanvir*|*"Farhan Tanvir"*)
            exit 0
            ;;
    esac

    if [ "$ALLOW_MAIN_COMMIT" = "1" ]; then
        exit 0
    fi

    echo ""
    echo "========================================================================"
    echo "ERROR: Direct commits to 'main' are blocked by branch protection rules."
    echo "========================================================================"
    echo "The 'main' branch is protected. Create a feature branch and open a Pull"
    echo "Request on GitHub for review and approval:"
    echo ""
    echo "   git checkout -b feature/<topic>"
    echo "   git commit -m \"Describe your change\""
    echo "   git push -u origin feature/<topic>"
    echo "========================================================================"
    echo ""
    exit 1
fi

exit 0
