#!/usr/bin/env sh
# ============================================================================
# MERAMOT GIT HOOK: Protect 'main' against direct non-admin pushes & force push
# ============================================================================

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ] || [ "$BRANCH" = "main" ]; then
        GIT_USER=$(git config user.name 2>/dev/null)
        GIT_EMAIL=$(git config user.email 2>/dev/null)

        case "$GIT_USER $GIT_EMAIL" in
            *farhantanvir*|*"Farhan Tanvir"*)
                exit 0
                ;;
        esac

        if [ "$ALLOW_MAIN_COMMIT" = "1" ]; then
            exit 0
        fi

        echo ""
        echo "========================================================================"
        echo "ERROR: Direct pushes to 'main' are blocked by branch protection rules."
        echo "========================================================================"
        echo "The 'main' branch is protected on GitHub. Push your commits to a feature"
        echo "branch and open a Pull Request for code-owner review:"
        echo ""
        echo "   git checkout -b feature/<topic>"
        echo "   git push -u origin feature/<topic>"
        echo "========================================================================"
        echo ""
        exit 1
    fi
done

exit 0
